<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://music-encoding.org/schema/5.1/mei-basic.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1+basic">
  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Dynamics and Expression</title>
      </titleStmt>
      <pubStmt />
    </fileDesc>
  </meiHead>
  <music>
    <body>
      <mdiv>
        <score>
          <scoreDef>
            <staffGrp>
              <staffDef n="1" lines="5" clef.shape="G" clef.line="2" meter.count="4" meter.unit="4" keysig="1f" />
            </staffGrp>
          </scoreDef>
          <section>
            <!-- m1-2: Opening — tempo, p, crescendo -->
            <measure n="1" xml:id="m1">
              <staff n="1">
                <layer n="1">
                  <note xml:id="n1" dur="4" oct="4" pname="d" />
                  <note xml:id="n2" dur="4" oct="4" pname="f" />
                  <note xml:id="n3" dur="4" oct="4" pname="a" />
                  <note xml:id="n4" dur="4" oct="4" pname="g" />
                </layer>
              </staff>
              <tempo xml:id="tempo1" startid="#n1" place="above">Andante espressivo</tempo>
              <dynam xml:id="dyn1" startid="#n1" place="below">p</dynam>
            </measure>
            <measure n="2" xml:id="m2">
              <staff n="1">
                <layer n="1">
                  <note xml:id="n5" dur="4" oct="4" pname="a" />
                  <note xml:id="n6" dur="4" oct="4" pname="b" accid.ges="f" />
                  <note xml:id="n7" dur="4" oct="5" pname="c" />
                  <note xml:id="n8" dur="4" oct="5" pname="d" />
                </layer>
              </staff>
              <hairpin xml:id="hp1" startid="#n5" endid="#n8" form="cres" place="below" />
            </measure>
            <!-- m3-4: Climax — f, espressivo, phrase, diminuendo -->
            <measure n="3" xml:id="m3">
              <staff n="1">
                <layer n="1">
                  <note xml:id="n9" dur="4" oct="5" pname="f" />
                  <note xml:id="n10" dur="4" oct="5" pname="e" />
                  <note xml:id="n11" dur="4" oct="5" pname="d" />
                  <note xml:id="n12" dur="4" oct="5" pname="c" />
                </layer>
              </staff>
              <dynam xml:id="dyn2" startid="#n9" place="below">f</dynam>
              <dir xml:id="dir1" startid="#n9" place="above">espressivo</dir>
              <phrase xml:id="phr1" startid="#n9" endid="#n12" />
            </measure>
            <measure n="4" xml:id="m4">
              <staff n="1">
                <layer n="1">
                  <note xml:id="n13" dur="4" oct="4" pname="b" accid.ges="f" />
                  <note xml:id="n14" dur="4" oct="4" pname="a" />
                  <note xml:id="n15" dur="2" oct="4" pname="g" />
                </layer>
              </staff>
              <hairpin xml:id="hp2" startid="#n13" endid="#n15" form="dim" place="below" />
              <breath xml:id="br1" startid="#n15" place="above" />
            </measure>
            <!-- m5-6: Quiet return — pp, tie across barline -->
            <measure n="5" xml:id="m5">
              <staff n="1">
                <layer n="1">
                  <note xml:id="n16" dur="4" oct="4" pname="d" />
                  <note xml:id="n17" dur="4" oct="4" pname="f" />
                  <note xml:id="n18" dur="4" oct="4" pname="a" />
                  <note xml:id="n19" dur="4" oct="4" pname="g" />
                </layer>
              </staff>
              <dynam xml:id="dyn3" startid="#n16" place="below">pp</dynam>
              <tie xml:id="tie1" startid="#n19" endid="#n20" />
            </measure>
            <measure n="6" xml:id="m6">
              <staff n="1">
                <layer n="1">
                  <note xml:id="n20" dur="4" oct="4" pname="g" />
                  <note xml:id="n21" dur="4" oct="4" pname="f" />
                  <note xml:id="n22" dur="4" oct="4" pname="e" />
                  <note xml:id="n23" dur="4" oct="4" pname="d" />
                </layer>
              </staff>
              <phrase xml:id="phr2" startid="#n20" endid="#n23" />
            </measure>
            <!-- m7-8: Closing — rit., caesura, fermata -->
            <measure n="7" xml:id="m7">
              <staff n="1">
                <layer n="1">
                  <note xml:id="n24" dur="4" oct="4" pname="c" />
                  <note xml:id="n25" dur="4" oct="4" pname="e" />
                  <note xml:id="n26" dur="2" oct="4" pname="f" />
                </layer>
              </staff>
              <dir xml:id="dir2" startid="#n24" place="above">rit.</dir>
              <caesura xml:id="cae1" startid="#n26" />
            </measure>
            <measure n="8" xml:id="m8" right="end">
              <staff n="1">
                <layer n="1">
                  <note xml:id="n27" dur="1" oct="4" pname="d" />
                </layer>
              </staff>
              <dynam xml:id="dyn4" startid="#n27" place="below">ppp</dynam>
              <fermata xml:id="f1" startid="#n27" place="above" />
            </measure>
          </section>
        </score>
      </mdiv>
    </body>
  </music>
</mei>
