<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://music-encoding.org/schema/5.1/mei-basic.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1+basic">
  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Chords and Multiple Voices</title>
      </titleStmt>
      <pubStmt />
    </fileDesc>
  </meiHead>
  <music>
    <body>
      <mdiv>
        <score>
          <scoreDef>
            <staffGrp>
              <staffDef n="1" lines="5" clef.shape="G" clef.line="2" meter.count="4" meter.unit="4" keysig="1s" />
            </staffGrp>
          </scoreDef>
          <section>
            <!-- Chorale-style passage in G major, 2 layers throughout -->
            <measure n="1" xml:id="m1">
              <staff n="1">
                <layer n="1">
                  <chord xml:id="c1" dur="4" stem.dir="up">
                    <note xml:id="n1" oct="4" pname="b" />
                    <note xml:id="n2" oct="4" pname="g" />
                  </chord>
                  <chord xml:id="c2" dur="4" stem.dir="up">
                    <note xml:id="n3" oct="4" pname="a" />
                    <note xml:id="n4" oct="4" pname="f" />
                  </chord>
                  <chord xml:id="c3" dur="4" stem.dir="up">
                    <note xml:id="n5" oct="4" pname="g" />
                    <note xml:id="n6" oct="4" pname="e" />
                  </chord>
                  <chord xml:id="c4" dur="4" stem.dir="up">
                    <note xml:id="n7" oct="4" pname="a" />
                    <note xml:id="n8" oct="4" pname="f" />
                  </chord>
                </layer>
                <layer n="2">
                  <note xml:id="n9" dur="2" oct="3" pname="g" stem.dir="down" />
                  <note xml:id="n10" dur="2" oct="3" pname="a" stem.dir="down" />
                </layer>
              </staff>
            </measure>
            <measure n="2" xml:id="m2">
              <staff n="1">
                <layer n="1">
                  <chord xml:id="c5" dur="4" stem.dir="up">
                    <note xml:id="n11" oct="4" pname="b" />
                    <note xml:id="n12" oct="4" pname="g" />
                  </chord>
                  <chord xml:id="c6" dur="4" stem.dir="up">
                    <note xml:id="n13" oct="5" pname="c" />
                    <note xml:id="n14" oct="4" pname="a" />
                  </chord>
                  <chord xml:id="c7" dur="2" stem.dir="up">
                    <note xml:id="n15" oct="4" pname="b" />
                    <note xml:id="n16" oct="4" pname="g" />
                  </chord>
                </layer>
                <layer n="2">
                  <note xml:id="n17" dur="4" oct="3" pname="g" stem.dir="down" />
                  <note xml:id="n18" dur="4" oct="3" pname="d" stem.dir="down" />
                  <note xml:id="n19" dur="2" oct="3" pname="g" stem.dir="down" />
                </layer>
              </staff>
              <fermata xml:id="f1" startid="#c7" place="above" />
              <fermata xml:id="f1b" startid="#n19" place="below" />
            </measure>
            <!-- Second phrase -->
            <measure n="3" xml:id="m3">
              <staff n="1">
                <layer n="1">
                  <chord xml:id="c8" dur="4" stem.dir="up">
                    <note xml:id="n20" oct="5" pname="d" />
                    <note xml:id="n21" oct="4" pname="b" />
                  </chord>
                  <chord xml:id="c9" dur="4" stem.dir="up">
                    <note xml:id="n22" oct="5" pname="c" />
                    <note xml:id="n23" oct="4" pname="a" />
                  </chord>
                  <chord xml:id="c10" dur="4" stem.dir="up">
                    <note xml:id="n24" oct="4" pname="b" />
                    <note xml:id="n25" oct="4" pname="g" />
                  </chord>
                  <chord xml:id="c11" dur="4" stem.dir="up">
                    <note xml:id="n26" oct="4" pname="a" />
                    <note xml:id="n27" oct="4" pname="f" />
                  </chord>
                </layer>
                <layer n="2">
                  <note xml:id="n28" dur="4" oct="3" pname="g" stem.dir="down" />
                  <note xml:id="n29" dur="4" oct="3" pname="a" stem.dir="down" />
                  <note xml:id="n30" dur="4" oct="3" pname="b" stem.dir="down" />
                  <note xml:id="n31" dur="4" oct="3" pname="d" stem.dir="down" />
                </layer>
              </staff>
            </measure>
            <measure n="4" xml:id="m4">
              <staff n="1">
                <layer n="1">
                  <chord xml:id="c12" dur="4" stem.dir="up">
                    <note xml:id="n32" oct="4" pname="g" />
                    <note xml:id="n33" oct="4" pname="e" />
                  </chord>
                  <chord xml:id="c13" dur="4" stem.dir="up">
                    <note xml:id="n34" oct="4" pname="a" />
                    <note xml:id="n35" oct="4" pname="f" />
                  </chord>
                  <chord xml:id="c14" dur="2" stem.dir="up">
                    <note xml:id="n36" oct="4" pname="g" />
                    <note xml:id="n37" oct="4" pname="d" />
                  </chord>
                </layer>
                <layer n="2">
                  <note xml:id="n38" dur="4" oct="3" pname="e" stem.dir="down" />
                  <note xml:id="n39" dur="4" oct="3" pname="d" stem.dir="down" />
                  <note xml:id="n40" dur="2" oct="3" pname="g" stem.dir="down" />
                </layer>
              </staff>
              <fermata xml:id="f2" startid="#c14" place="above" />
              <fermata xml:id="f2b" startid="#n40" place="below" />
            </measure>
            <!-- Third phrase -->
            <measure n="5" xml:id="m5">
              <staff n="1">
                <layer n="1">
                  <chord xml:id="c15" dur="4" stem.dir="up">
                    <note xml:id="n41" oct="4" pname="g" />
                    <note xml:id="n42" oct="4" pname="e" />
                  </chord>
                  <chord xml:id="c16" dur="4" stem.dir="up">
                    <note xml:id="n43" oct="4" pname="a" />
                    <note xml:id="n44" oct="4" pname="f" />
                  </chord>
                  <chord xml:id="c17" dur="4" stem.dir="up">
                    <note xml:id="n45" oct="4" pname="b" />
                    <note xml:id="n46" oct="4" pname="g" />
                  </chord>
                  <chord xml:id="c18" dur="4" stem.dir="up">
                    <note xml:id="n47" oct="5" pname="c" />
                    <note xml:id="n48" oct="4" pname="a" />
                  </chord>
                </layer>
                <layer n="2">
                  <note xml:id="n49" dur="4" oct="3" pname="e" stem.dir="down" />
                  <note xml:id="n50" dur="4" oct="3" pname="d" stem.dir="down" />
                  <note xml:id="n51" dur="4" oct="3" pname="g" stem.dir="down" />
                  <note xml:id="n52" dur="4" oct="3" pname="a" stem.dir="down" />
                </layer>
              </staff>
            </measure>
            <measure n="6" xml:id="m6">
              <staff n="1">
                <layer n="1">
                  <chord xml:id="c19" dur="4" stem.dir="up">
                    <note xml:id="n53" oct="5" pname="d" />
                    <note xml:id="n54" oct="4" pname="b" />
                  </chord>
                  <chord xml:id="c20" dur="4" stem.dir="up">
                    <note xml:id="n55" oct="5" pname="c" />
                    <note xml:id="n56" oct="4" pname="a" />
                  </chord>
                  <chord xml:id="c21" dur="2" stem.dir="up">
                    <note xml:id="n57" oct="4" pname="b" />
                    <note xml:id="n58" oct="4" pname="g" />
                  </chord>
                </layer>
                <layer n="2">
                  <note xml:id="n59" dur="4" oct="3" pname="b" stem.dir="down" />
                  <note xml:id="n60" dur="4" oct="3" pname="d" stem.dir="down" />
                  <note xml:id="n61" dur="2" oct="3" pname="g" stem.dir="down" />
                </layer>
              </staff>
              <fermata xml:id="f3" startid="#c21" place="above" />
              <fermata xml:id="f3b" startid="#n61" place="below" />
            </measure>
            <!-- Final phrase: V-I cadence -->
            <measure n="7" xml:id="m7">
              <staff n="1">
                <layer n="1">
                  <chord xml:id="c22" dur="4" stem.dir="up">
                    <note xml:id="n62" oct="4" pname="b" />
                    <note xml:id="n63" oct="4" pname="g" />
                  </chord>
                  <chord xml:id="c23" dur="4" stem.dir="up">
                    <note xml:id="n64" oct="4" pname="a" />
                    <note xml:id="n65" oct="4" pname="e" />
                  </chord>
                  <chord xml:id="c24" dur="4" stem.dir="up">
                    <note xml:id="n66" oct="4" pname="a" />
                    <note xml:id="n67" oct="4" pname="f" />
                  </chord>
                  <chord xml:id="c25" dur="4" stem.dir="up">
                    <note xml:id="n68" oct="4" pname="b" />
                    <note xml:id="n69" oct="4" pname="g" />
                  </chord>
                </layer>
                <layer n="2">
                  <note xml:id="n70" dur="4" oct="3" pname="g" stem.dir="down" />
                  <note xml:id="n71" dur="4" oct="3" pname="a" stem.dir="down" />
                  <note xml:id="n72" dur="2" oct="3" pname="d" stem.dir="down" />
                </layer>
              </staff>
            </measure>
            <measure n="8" xml:id="m8" right="end">
              <staff n="1">
                <layer n="1">
                  <chord xml:id="c26" dur="1" stem.dir="up">
                    <note xml:id="n73" oct="4" pname="g" />
                    <note xml:id="n74" oct="4" pname="d" />
                  </chord>
                </layer>
                <layer n="2">
                  <note xml:id="n75" dur="1" oct="3" pname="g" stem.dir="down" />
                </layer>
              </staff>
              <fermata xml:id="f4" startid="#c26" place="above" />
              <fermata xml:id="f4b" startid="#n75" place="below" />
            </measure>
          </section>
        </score>
      </mdiv>
    </body>
  </music>
