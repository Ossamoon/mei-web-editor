                  <note xml:id="ln10" dur="4" oct="3" pname="g" />
                  <note xml:id="ln11" dur="4" oct="3" pname="b" />
                  <note xml:id="ln12" dur="4" oct="3" pname="d" />
                </layer>
              </staff>
            </measure>
            <!-- A' phrase (m5-8): similar start, different ending -->
            <measure n="5" xml:id="m5">
              <staff n="1">
                <layer n="1">
                  <note xml:id="rn9" dur="4" oct="5" pname="d" />
