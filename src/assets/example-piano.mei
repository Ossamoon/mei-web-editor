                  <note xml:id="ln1" dur="4" oct="3" pname="g" />
                  <note xml:id="ln2" dur="4" oct="3" pname="b" />
                  <note xml:id="ln3" dur="4" oct="3" pname="d" />
                </layer>
              </staff>
              <slur xml:id="s1" startid="#rn1" endid="#rn3" />
            </measure>
            <measure n="2" xml:id="m2">
              <staff n="1">
                <layer n="1">
                  <note xml:id="rn4" dur="2" dots="1" oct="4" pname="g" />
                </layer>
              </staff>
