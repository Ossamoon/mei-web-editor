  <music>
    <body>
      <mdiv>
        <score>
          <scoreDef>
            <staffGrp symbol="brace" bar.thru="true">
              <staffDef n="1" lines="5" clef.shape="G" clef.line="2" meter.count="3" meter.unit="4" keysig="1s" />
              <staffDef n="2" lines="5" clef.shape="F" clef.line="4" meter.count="3" meter.unit="4" keysig="1s" />
            </staffGrp>
          </scoreDef>
          <section>
            <!-- A phrase (m1-4): waltz-style -->
            <measure n="1" xml:id="m1">
              <staff n="1">
                <layer n="1">
                  <note xml:id="rn1" dur="4" oct="5" pname="d" />
                  <note xml:id="rn2" dur="4" oct="4" pname="b" />
                  <note xml:id="rn3" dur="4" oct="4" pname="a" />
                </layer>
              </staff>
              <staff n="2">
