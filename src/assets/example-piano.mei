                </layer>
              </staff>
              <staff n="2">
                <layer n="1">
                  <note xml:id="ln7" dur="4" oct="3" pname="d" />
                  <note xml:id="ln8" dur="4" oct="3" pname="f" />
                  <note xml:id="ln9" dur="4" oct="3" pname="a" />
                </layer>
              </staff>
              <slur xml:id="s2" startid="#rn5" endid="#rn7" />
            </measure>
