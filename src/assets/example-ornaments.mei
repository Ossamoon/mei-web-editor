<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://music-encoding.org/schema/5.1/mei-basic.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1+basic">
  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Ornaments and Articulations</title>
      </titleStmt>
      <pubStmt />
    </fileDesc>
  </meiHead>
  <music>
    <body>
      <mdiv>
        <score>
          <scoreDef>
            <staffGrp>
              <staffDef n="1" lines="5" clef.shape="G" clef.line="2" meter.count="4" meter.unit="4" keysig="2f" />
            </staffGrp>
          </scoreDef>
          <section>
            <measure n="1" xml:id="m1">
              <staff n="1">
                <layer n="1">
                  <note xml:id="n1" dur="4" oct="4" pname="b" accid.ges="f" />
                  <note xml:id="n2" dur="8" oct="5" pname="c" />
                  <note xml:id="n3" dur="8" oct="5" pname="d" />
                  <note xml:id="n4" dur="4" oct="5" pname="e" accid.ges="f" />
                  <note xml:id="n5" dur="4" oct="5" pname="d" />
                </layer>
              </staff>
              <slur xml:id="s1" startid="#n1" endid="#n3" />
              <fermata xml:id="f1" startid="#n5" place="above" />
            </measure>
            <measure n="2" xml:id="m2">
              <staff n="1">
                <layer n="1">
                  <note xml:id="n6" dur="4" oct="5" pname="c" artic="stacc" />
                  <note xml:id="n7" dur="4" oct="4" pname="b" accid.ges="f" artic="stacc" />
                  <note xml:id="n8" dur="4" oct="4" pname="a" accid="n" artic="ten" />
                  <note xml:id="n9" dur="4" oct="4" pname="b" accid.ges="f" artic="accent" />
                </layer>
              </staff>
              <trill xml:id="t1" startid="#n6" place="above" />
            </measure>
            <measure n="3" xml:id="m3">
              <staff n="1">
                <layer n="1">
                  <beam>
                    <note xml:id="n10" dur="8" oct="4" pname="g" />
                    <note xml:id="n11" dur="8" oct="4" pname="a" accid="n" />
                    <note xml:id="n12" dur="8" oct="4" pname="b" accid.ges="f" />
                    <note xml:id="n13" dur="8" oct="5" pname="c" />
                  </beam>
                  <note xml:id="n14" dur="4" oct="5" pname="d" />
                  <note xml:id="n15" dur="4" oct="5" pname="e" accid.ges="f" />
                </layer>
              </staff>
              <turn xml:id="tu1" startid="#n14" place="above" />
              <slur xml:id="s2" startid="#n14" endid="#n15" />
            </measure>
            <measure n="4" xml:id="m4" right="end">
              <staff n="1">
                <layer n="1">
                  <note xml:id="n16" dur="1" oct="4" pname="b" accid.ges="f" />
                </layer>
              </staff>
              <fermata xml:id="f2" startid="#n16" place="above" />
            </measure>
          </section>
        </score>
      </mdiv>
    </body>
  </music>
</mei>
